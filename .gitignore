# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local data store (runtime state, regenerated from the seed)
/data/store.json

# Brand reference assets downloaded from the live site
/.brand

.vercel
.env*

# Generated PDFs (regenerate with the Edge command in DEPLOYMENT.md)
/docs/pdf/*.pdf

# GitHub read-only token, used to read CI logs. Never committed.
/.github-token
