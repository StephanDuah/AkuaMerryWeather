# Supply-chain controls for installing dependencies.
#
# Read by npm locally and by Vercel during the build, so the same rules apply
# on a laptop and in production.

# ---------------------------------------------------------------------------
# Do not execute a dependency's install-time scripts.
#
# This is the single most effective control here. Almost every npm
# supply-chain attack of the last few years worked the same way: an attacker
# takes over a package - by compromising a maintainer's account, buying an
# abandoned one, or slipping in through a typo-squatted name - and adds a
# `postinstall` script. That script then runs, with the developer's full
# permissions, the moment anyone installs. It does not need the application
# to import the package, or even to use it. event-stream, ua-parser-js, coa,
# rc and node-ipc were all delivered this way.
#
# With this set, that code never runs. A compromised package can still do
# harm if the application actually calls it, but the install itself stops
# being a way in.
#
# Checked before switching it on: of the 456 packages in this project's tree,
# exactly one declares an install script - unrs-resolver, a development-only
# native resolver used by ESLint. A clean `npm ci --ignore-scripts` followed
# by typecheck, lint and a production build all passed, so nothing here needs
# those scripts. Re-check with `npm run audit:deps` if a new dependency is
# ever added.
ignore-scripts=true

# ---------------------------------------------------------------------------
# Install exactly what is asked for, not "whatever is newest and compatible".
#
# `npm install some-package` now records an exact version rather than a
# caret range, so a future install cannot silently pick up a version nobody
# has tested or reviewed.
save-exact=true

# ---------------------------------------------------------------------------
# Quieter, more useful output.
fund=false
audit-level=moderate
