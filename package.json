{
  "name": "merry-cleaners",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "reset-data": "node -e \"require('fs').rmSync('data/store.json',{force:true});console.log('Local data reset. It will be recreated with the sample records on next start.')\"",
    "test:agent": "node tests/agent-scenarios.mjs",
    "test:prospecting": "node tests/prospecting.mjs",
    "test:security": "node tests/security.mjs",
    "test:pricing": "node tests/pricing.mjs",
    "audit:deps": "node tests/dependencies.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "npm run audit:deps && npm run typecheck && eslint src --ext .ts,.tsx && npm run build",
    "test:conversation": "node tests/conversation.mjs",
    "test:field-errors": "node tests/field-errors.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.28.1",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  }
}
